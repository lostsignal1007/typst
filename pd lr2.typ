= 2. РЕШЕНИЕ ЗАДАЧ #text(size:14pt)[(методом изоклин)] ]
\
== #underline[Пример 2.1.]

Рассмотрим дифференциальное уравнение $y' = x^2 + y^2$. Все изоклины этого уравнения — окружности, поскольку они описываются уравнениями $x^2 + y^2 = k$, $k > 0$. 
    
На #text(fill:purple)[*рис. 2.1*] изображены изоклины для $k = 1, 2, ..., 15, 16$ и интегральная кривая, проходящая через точку $(0, 0)$. Чем больше радиус окружности-изоклины, тем быстрее растёт решение уравнения.
#align(center)[
  #import "@preview/cetz:0.5.2"

  #cetz.canvas({
    let d = cetz.draw
    d.scale(1.3)

    // 1. Координатные оси
    d.line((-4.5, 0), (4.5, 0), mark: (end: ">"), stroke: 0.6pt)
    d.content((4.3, -0.3), [$x$])
    
    d.line((0, -4.5), (0, 4.5), mark: (end: ">"), stroke: 0.6pt)
    d.content((0.3, 4.3), [$y$])

    // 2. Изоклины и штрихи поля направлений
    // range(1, 17) дает k от 1 до 16. Радиус окружности R = sqrt(k)
    for k in range(1, 17) {
      let r = calc.sqrt(k)
      // Рисуем окружность-изоклину
      d.circle((0, 0), radius: r, stroke: blue.lighten(50%) + 0.4pt)

      // Рисуем штрихи (по 24 штуки на каждую окружность для высокой плотности)
      let num_strokes = 24
      for i in range(num_strokes) {
        let a = i * 2 * calc.pi / num_strokes
        let px = r * calc.cos(a)
        let py = r * calc.sin(a)
        
        // Угловой коэффициент касательной на этой изоклине равен k
        let h = calc.atan(k)
        let dx = 0.07 * calc.cos(h)
        let dy = 0.07 * calc.sin(h)
        
        d.line((px - dx, py - dy), (px + dx, py + dy), stroke: gray.darken(30%) + 0.4pt)
      }
    }

    // 3. Интегральная кривая через (0,0)
    // Подбираем точки, чтобы кривая имела горизонтальное касание в нуле и уходила круто вверх
    let curve-pts = (
      (-1.7, -4.2),
      (-1.3, -2.0),
      (-0.9, -0.8),
      (-0.5, -0.2),
      (0.0, 0.0),   // Точка касания (0,0)
      (0.5, 0.2),
      (0.9, 0.8),
      (1.3, 2.0),
      (1.7, 4.2)
    )
    d.line(..curve-pts, stroke: red.darken(10%) + 2.5pt, transition: "bezier")
    
    // Начальная точка задачи Коши (0,0)
    d.circle((0, 0), radius: 0.05, fill: red, stroke: none)
  })
]
#align(center)[#text(size: 11pt, fill: rgb("990099"), weight: "bold")[_Рис.2.1. Изоклины и интегральная кривая уравнения $y' = x^2 + y^2$_]]


== #underline[Пример 2.2.]

\
Найдем изоклины уравнения $y' = y^2 - x$ и изобразим интегральную кривую, проходящую через точку $(0, 1)$. Изоклины уравнения определяются уравнениями $y^2 - x = k$. Это параболы $x = y^2 - k$. \ На #text(fill:purple)[*рис. 2.2*] изображены изоклины $y^2 - x = -3, -2, -1, 0, 1, 2, 3, 4$.,
  
#align(center)[
  #import "@preview/cetz:0.5.2"

  #cetz.canvas({
    let d = cetz.draw
    d.scale(1.3)

    // 1. Координатные оси
    d.line((-4.5, 0), (4.5, 0), mark: (end: ">"), stroke: 0.6pt)
    d.content((4.3, -0.3), [$x$])
    
    d.line((0, -3.5), (0, 3.5), mark: (end: ">"), stroke: 0.6pt)
    d.content((0.3, 3.3), [$y$])
    d.content((-0.2, -0.2), [0], size: 10pt)

    // Список значений k по условию задачи
    let k-values = (-3, -2, -1, 0, 1, 2, 3, 4)

    // 2. Отрисовка парабол x = y^2 - k
    for k in k-values {
      let pts = ()
      // Генерируем точки параболы по y от -3 до 3 с малым шагом
      let y = -3.0
      while y <= 3.0 {
        let x = calc.pow(y, 2) - k
        // Ограничиваем координаты, чтобы линии не вылезали далеко за оси
        if x <= 4.2 and x >= -4.2 {
          pts.push((x, y))
        }
        y += 0.1
      }
      if pts.len() > 1 {
        d.line(..pts, stroke: blue.lighten(40%) + 0.5pt, transition: "bezier")
      }
    }
  })
]
#align(center)[#text(size: 11pt, fill: rgb("990099"), weight: "bold")[_Рис.2.2. Изоклины уравнения при заданных значениях k_]]

  \
  \
Внимательно рассмотрев рисунок, легко провести интегральную кривую через точку $(0,1)$. Поле направлений, изоклины и интегральная кривая, проходящая через точку $(0,1)$, изображены на #text(fill:purple)[*рис. 2.3*]


#align(center)[
  #import "@preview/cetz:0.5.2"

  #cetz.canvas({
    let d = cetz.draw
    d.scale(1.3)

    // 1. Координатные оси
    d.line((-4.5, 0), (4.5, 0), mark: (end: ">"), stroke: 0.6pt)
    d.content((4.3, -0.3), [$x$])
    
    d.line((0, -3.5), (0, 3.5), mark: (end: ">"), stroke: 0.6pt)
    d.content((0.3, 3.3), [$y$])
    d.content((-0.2, -0.2), [0], size: 10pt)

    // 2. Изоклины (параболы)
    let k-values = (-3, -2, -1, 0, 1, 2, 3, 4)
    for k in k-values {
      let pts = ()
      let y = -3.0
      while y <= 3.0 {
        let x = calc.pow(y, 2) - k
        if x <= 4.2 and x >= -4.2 {
          pts.push((x, y))
        }
        y += 0.1
      }
      if pts.len() > 1 {
        d.line(..pts, stroke: blue.lighten(60%) + 0.4pt, transition: "bezier")
      }
    }

    // 3. Поле направлений (сетка штрихов)
    // Перебираем узлы прямоугольной сетки с шагом 0.4
    let xs = -4.0
    while xs <= 4.0 {
      let ys = -3.0
      while ys <= 3.0 {
        // Производная в данной точке: f(x, y) = y^2 - x
        let f_val = calc.pow(ys, 2) - xs
        let angle = calc.atan(f_val)
        
        // Длина штриха
        let len = 0.07
        let dx = len * calc.cos(angle)
        let dy = len * calc.sin(angle)
        
        d.line((xs - dx, ys - dy), (xs + dx, ys + dy), stroke: gray.darken(20%) + 0.4pt)
        ys += 0.4
      }
      xs += 0.4
    }

    // 4. Точка (0, 1) через которую проходит решение
    d.circle((0, 1), radius: 0.05, fill: red, stroke: none)
    d.content((0.3, 1.2), [$(0,1)$], size: 9pt, fill: red.darken(20%))

    // 5. Интегральная кривая (построена по характерным точкам из Рис. 2.2)
    let curve-pts = (
      (-4.0, -1.8),
      (-2.0, -0.8),
      (-1.0, -0.2),
      (-0.5, 0.3),
      (0.0, 1.0),   // Проходит строго через (0, 1)
      (0.3, 1.4),
      (0.7, 1.8),
      (1.2, 2.2),
      (2.0, 2.5),
      (4.0, 2.8)
    )
    d.line(..curve-pts, stroke: red.darken(10%) + 2pt, transition: "bezier")
  })
]
#align(center)[#text(size: 11pt, fill: rgb("990099"), weight: "bold")[_Рис.2.3. Поле направлений, изоклины и интегральная кривая, проходящая через точку (0,1)_]]